        {
          "vendor": "dsh",
          "displayName": "%dsh.lm.vendor%"
        }
      ],
      "chatParticipants": [
        {
          "id": "dsh",
          "name": "%dsh.participant.name%",
          "description": "%dsh.participant.description%"
        }
      ],
      "viewsContainers": {
        "secondarySidebar": [
          {
            "id": "dsh-sidebar",
            "title": "%dsh.view.title%",
            "icon": "media/deepseek.svg"
          }
        ]
      },
      "views": {
        "dsh-sidebar": [
          {
            "type": "webview",
            "id": "dsh.webview",
            "name": "%dsh.view.name%"
          },
          {
            "type": "tree",
            "id": "dsh.changes",
            "name": "%dsh.view.changes%",
            "when": "config.dsh.features.changes-review"
          }
        ]
      },
      "viewsWelcome": [
        {
          "view": "dsh.changes",
          "contents": "%dsh.view.welcome.changes%"
        }
      ],
      "commands": [
