{
	// 仅做类型检查，不产出编译文件；现有 JS 源码保持原样运行。
	// Type-check only. The extension still runs the existing JS sources as-is.
	"compilerOptions": {
		"target": "ES2022",
		"lib": ["ES2022"],
		"module": "node16",
		"moduleResolution": "node16",
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"strict": true,
		"skipLibCheck": true,
		"esModuleInterop": true,
		"resolveJsonModule": true,
		"forceConsistentCasingInFileNames": true,
		"newLine": "lf"
	},
	"include": ["src/**/*.js", "src/**/*.ts"],
	"exclude": ["node_modules", "out", "dist", ".vscode-test"]
}