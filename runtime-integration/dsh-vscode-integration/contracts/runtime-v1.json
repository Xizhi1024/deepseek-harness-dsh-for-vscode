              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "index": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "text": {
              "type": "string",
              "minLength": 0,
