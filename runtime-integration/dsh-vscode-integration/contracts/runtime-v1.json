                "oneOf": [
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "upsert"
                      },
                      "record": {
                        "$ref": "#/$defs/TranscriptRecord"
                      }
                    },
                    "required": [
                      "op",
                      "record"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "op": {
                        "const": "remove"
                      },
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 256
                      }
                    },
                    "required": [
                      "op",
                      "id"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              "maxItems": 1000
            }
          },
          "required": [
            "runtimeInstanceId",
            "sessionId",
            "streamEpoch",
            "deliverySeq",
            "kind",
            "durableSeq",
            "changes"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
